# Sobrescritas de PRODUÇÃO anexadas ao .env do servidor pelo deploy.sh (o .env do dev vai por scp; nunca fica na imagem).
# Segredos NÃO entram aqui — só configuração.
ENV=prod
AUTH_HEADERS_DEV=false
# O navegador só fala com a Vercel (HTTPS, mesma origem via rewrite /api): cookie Secure + Lax.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
LLM_STREAM=true
# Aiven tem poucos slots: api e worker abrem 2 pools cada (app + service) → 2 conexões por pool no máximo.
DB_POOL_MIN=0
DB_POOL_MAX=2
# Origens do frontend (JSON). Esta lista NÃO é só CORS: `verificar_origem` (app/api/deps.py) recusa
# com 403 "origem não permitida" toda mutação cujo header `Origin` esteja fora dela — inclusive quando
# a chamada é MESMA ORIGEM, porque o navegador manda `Origin` em todo POST e a Vercel o repassa para
# a EC2 no rewrite `/api/*`. Domínio novo no ar sem entrar aqui = cadastro e login em 403.
# `plexobr.com` (2026-09-09): o apex é o que o navegador usa; `www` só redireciona (308), mas fica na
# lista porque um POST redirecionado pode chegar com o Origin do host de partida.
# Os DOIS aliases da Vercel (2026-08-26): `-two` porque plexo-copiloto.vercel.app ficou com o projeto
# antigo. NÃO use a URL por deploy (…-ckwzaa6dj-…): ela muda a cada publicação.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://plexobr.com","https://www.plexobr.com","https://plexo-copiloto-two.vercel.app","https://plexo-copiloto-gabrielrosa1s-projects.vercel.app","https://3-236-177-183.sslip.io:81"]
